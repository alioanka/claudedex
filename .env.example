# ============================================================================
# CLAUDEDEX TRADING BOT - ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains ONLY sensitive data that cannot be stored in the database:
# - API keys, secrets, tokens
# - Private keys, wallet addresses
# - Passwords, encryption keys
# - RPC URLs (shared infrastructure)
#
# All OTHER configuration (trading parameters, risk settings, strategies, etc.)
# should be managed via the Settings pages in the dashboard. These settings are
# stored in the database and can be changed without restarting the application.
#
# Settings Pages:
# - /settings          - Module control, account settings
# - /futures/settings  - Futures module configuration
# - /solana/settings   - Solana module configuration
# - /dex/settings      - DEX module configuration
#
# Copy this file to .env and fill in your actual values.
# IMPORTANT: Never commit .env to version control!
# ============================================================================

# ============================================================================
# CORE SECURITY & ENCRYPTION
# ============================================================================
# ENCRYPTION KEY — do NOT put it here. secrets_manager loads it from a FILE,
# in this priority: Docker secret /run/secrets/encryption_key  ->  external
# file $ENCRYPTION_KEY_FILE (default /secure/encryption.key)  ->  project
# ./.encryption_key  ->  (last-resort migration only) the ENCRYPTION_KEY env var.
# Recommended: keep the key in /secure/encryption.key (chmod 600) or a Docker
# secret. The ENCRYPTION_KEY env line below is a deprecated fallback — leave it
# UNSET in production. The key decrypts everything in the secure_credentials DB
# table, so it must NOT live in the same .env as everything else.
# ENCRYPTION_KEY=   # leave unset; use the key FILE instead (see ENCRYPTION_KEY_FILE)
ENCRYPTION_KEY_FILE=/secure/encryption.key   # path to the master key file (chmod 600, dir 700)
SESSION_SECRET=your_random_session_secret_here
JWT_SECRET=your_random_jwt_secret_here
API_KEY=your_api_key_for_external_access
DASHBOARD_API_KEY=your_dashboard_api_key

# --- Dashboard exposure (Wave-F6 security) ---
# docker-compose publishes the dashboard control plane on host port 8080
# (0.0.0.0 -> public internet on a VPS). It IS actively probed (Mirai RCE
# attempts, /api/.env fishing were observed). Firewall 8080 to operator IPs,
# or bind it to 127.0.0.1 and use an SSH tunnel/VPN, or front it with a
# TLS reverse proxy. See the comment above `ports:` in docker-compose.yml.
#
# CORS allowlist for the dashboard HTTP API and Socket.IO. Comma-separated
# exact origins; requests from other origins cannot read authenticated
# responses. NEVER set '*' here (it is filtered out server-side because
# wildcard + credentials is an account-takeover primitive).
DASHBOARD_CORS_ORIGINS=http://localhost:8080
# 'auto' (default) marks session/CSRF cookies Secure only when the request
# arrived over HTTPS (directly or via X-Forwarded-Proto from a TLS proxy).
DASHBOARD_HTTPS=auto

# ----------------------------------------------------------------------------
# SECRETS MODEL (read this): every sensitive value below — wallet private keys,
# exchange/tool API keys — should be stored ENCRYPTED in the DB via the
# dashboard "Secure Credentials" page (secrets_manager resolves DB-first, then
# falls back to these env vars). Wallet ADDRESSES are DERIVED from the private
# keys, never configured separately. The entries below are a TEMPLATE / fresh-
# install fallback only; a production .env can contain just: the DB connection,
# the module *_ENABLED flags, and (optionally) RPC URLs for first boot.
# ----------------------------------------------------------------------------

# ============================================================================
# MODULE ENABLE/DISABLE FLAGS
# ============================================================================
# These are the ONLY module flags in .env because they control process startup
DEX_MODULE_ENABLED=true
FUTURES_MODULE_ENABLED=false
SOLANA_MODULE_ENABLED=false
POLYMARKET_MODULE_ENABLED=false  # Prediction-market module; LIVE execution gated OFF by default (shadow mode)
POLYMARKET_HEALTH_PORT=8089
META_CONTROLLER_MODULE_ENABLED=false  # Self-deciding advisory layer; autopilot gated OFF (meta_autopilot_enabled in DB)
META_CONTROLLER_HEALTH_PORT=8090
REGIME_ALLOCATOR_MODULE_ENABLED=false  # Volatility-regime capital allocator; ADVISORY ONLY (proposals need operator approval)
REGIME_ALLOCATOR_HEALTH_PORT=8091
EXECUTION_QUALITY_MODULE_ENABLED=false  # TCA — read-only execution-cost measurement; never trades
EXECUTION_QUALITY_HEALTH_PORT=8092
TREASURY_MODULE_ENABLED=false  # Phase-1 observe-only wallet/gas/inventory; never signs or transfers
TREASURY_HEALTH_PORT=8093
SENTINEL_MODULE_ENABLED=false  # Cross-module anomaly detection; auto-freeze gated OFF (sentinel_autopilot in DB)
SENTINEL_HEALTH_PORT=8094
MARKET_DATA_WAREHOUSE_MODULE_ENABLED=false  # Unified historical market-data store; never trades
MARKET_DATA_WAREHOUSE_HEALTH_PORT=8095
CATALYST_CALENDAR_MODULE_ENABLED=false  # Forward unlocks/listings/macro feed; advisory only
CATALYST_CALENDAR_HEALTH_PORT=8096
OPTIONS_VOL_MODULE_ENABLED=false  # Deribit vol/hedging advisory; shadow-first, BUY-only gated live path
OPTIONS_VOL_HEALTH_PORT=8097
YIELD_TREASURY_MODULE_ENABLED=false  # Idle-capital carry advisory (LST/lending); observe/advise only
YIELD_TREASURY_HEALTH_PORT=8098
EXECUTION_GATEWAY_MODULE_ENABLED=false  # MEV-aware EVM send-policy service; private routing OFF by default
EXECUTION_GATEWAY_HEALTH_PORT=8099
CLMM_LP_MODULE_ENABLED=false  # Concentrated-LP shadow proposals; live mint not implemented
CLMM_LP_HEALTH_PORT=8100
PARAM_TUNER_MODULE_ENABLED=false  # Bandit shadow-tuning of module knobs; bounded auto-apply gated OFF
PARAM_TUNER_HEALTH_PORT=8101
INTENT_SOLVER_MODULE_ENABLED=false  # CoW/UniswapX shadow scaffold; experimental, no live path
INTENT_SOLVER_HEALTH_PORT=8102
BASIS_DESK_MODULE_ENABLED=false  # Delta-neutral funding/basis carry advisor; shadow-first
BASIS_DESK_HEALTH_PORT=8103
STAT_ARB_MODULE_ENABLED=false  # Market-neutral pairs / mean-reversion; shadow-first, hard z-stops
STAT_ARB_HEALTH_PORT=8104
SMART_MONEY_MODULE_ENABLED=false  # On-chain accumulation-cluster signal; advisory, no look-ahead
SMART_MONEY_HEALTH_PORT=8105

# Operating mode (affects all modules)
MODE=production
DRY_RUN=true  # IMPORTANT: Set to false ONLY when ready for live trading!

# ============================================================================
# DATABASE & CACHE
# ============================================================================
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/trading_bot
DB_PASSWORD=your_secure_db_password
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password

# ============================================================================
# DEX MODULE - SENSITIVE DATA ONLY
# ============================================================================
# EVM Private Key (encrypted with ENCRYPTION_KEY)
PRIVATE_KEY=your_encrypted_private_key
WALLET_ADDRESS=0xYourWalletAddress

# Flashbots MEV Protection
FLASHBOTS_RPC=https://rpc.flashbots.net
FLASHBOTS_SIGNING_KEY=your_flashbots_signing_key

# Multi-Chain RPC URLs (comma-separated, shared by all EVM modules)
# Format: <CHAIN>_RPC_URLS - automatically detected by the engine
# NOTE: pool_engine reads RPC endpoints DB-FIRST from the `rpc_api_pool` table,
# managed in the dashboard at /settings/rpc-api. These env URLs are used ONLY as
# a FALLBACK for a fresh install when that table is still empty. Once you've
# added RPCs in the UI, the DB is authoritative and these are ignored.
#
# MULTI-ACCOUNT ROTATION (Wave-F5): every single-value RPC/API env var below
# also accepts numbered _2.._9 variants — one per provider account. Each
# becomes its own rotating endpoint at equal priority, so rate limits and
# monthly quotas are spread across accounts (e.g. two Alchemy accounts:
#   ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/key_A
#   ETHEREUM_RPC_URL_2=https://eth-mainnet.g.alchemy.com/v2/key_B
# same pattern for BASE_RPC_URL_2, ARBITRUM_RPC_URL_2, SOLANA_RPC_URL_2,
# SOLANA_WS_URL_2, HELIUS_API_KEY_2, ETHERSCAN_API_KEY_2, BIRDEYE_API_KEY_2 ...)
# See docs/RPC_API_KEYS_GUIDE.md for the full operator walkthrough.
# BULK VERIFY + IMPORT: have a spreadsheet of endpoints/keys and don't know
# which still work? Run scripts/verify_and_import_rpcs.py inside the container
# (dry-run report, then --apply) — see section 7 of docs/RPC_API_KEYS_GUIDE.md.
ETHEREUM_RPC_URLS=https://eth-mainnet.g.alchemy.com/v2/your_key
BSC_RPC_URLS=https://bsc-mainnet.nodereal.io/v1/your_key
POLYGON_RPC_URLS=https://polygon-mainnet.g.alchemy.com/v2/your_key
ARBITRUM_RPC_URLS=https://arb-mainnet.g.alchemy.com/v2/your_key
BASE_RPC_URLS=https://base-mainnet.g.alchemy.com/v2/your_key

# New chains (added 2025)
MONAD_RPC_URLS=https://rpc.monad.xyz
PULSECHAIN_RPC_URLS=https://rpc.pulsechain.com,https://pulsechain.publicnode.com
FANTOM_RPC_URLS=https://rpc.ftm.tools
CRONOS_RPC_URLS=https://evm.cronos.org
AVALANCHE_RPC_URLS=https://api.avax.network/ext/bc/C/rpc

# DEX Data Provider APIs
DEXSCREENER_API_KEY=not_required
GOPLUS_API_KEY=your_goplus_api_key
TOKENSNIFFER_API_KEY=your_tokensniffer_api_key
1INCH_API_KEY=your_1inch_api_key
PARASWAP_API_KEY=your_paraswap_api_key

# ============================================================================
# FUTURES MODULE - SENSITIVE DATA ONLY
# ============================================================================
# All trading parameters (leverage, position size, risk, pairs, strategy)
# are now managed via /futures/settings page and stored in database.

# Binance Futures API (Testnet)
BINANCE_TESTNET_API_KEY=your_testnet_api_key
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret

# Binance Futures API (Mainnet - use with caution!)
BINANCE_API_KEY=your_mainnet_api_key
BINANCE_API_SECRET=your_mainnet_api_secret

# Bybit Futures API (Testnet)
BYBIT_TESTNET_API_KEY=your_testnet_api_key
BYBIT_TESTNET_API_SECRET=your_testnet_api_secret

# Bybit Futures API (Mainnet)
BYBIT_API_KEY=your_mainnet_api_key
BYBIT_API_SECRET=your_mainnet_api_secret

# ============================================================================
# DEX MODULE - SOLANA CHAIN WALLET
# ============================================================================
# DEX Module uses this wallet for Solana chain trading (via Jupiter swaps)
# This is SEPARATE from the Solana Module wallet!
SOLANA_PRIVATE_KEY=your_encrypted_dex_solana_private_key
SOLANA_WALLET=YourDexSolanaWalletAddress

# ============================================================================
# SOLANA MODULE - DEDICATED WALLET
# ============================================================================
# Solana Module uses its OWN dedicated wallet (separate from DEX Module)
# All trading parameters (position size, risk, strategies, slippage)
# are managed via /solana/settings page and stored in database.

# Solana Module Private Key (encrypted with ENCRYPTION_KEY)
SOLANA_MODULE_PRIVATE_KEY=your_encrypted_solana_module_private_key
SOLANA_MODULE_WALLET=YourSolanaModuleWalletAddress

# ============================================================================
# SOLANA RPC URLs (shared by DEX and Solana modules)
# ============================================================================
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key
SOLANA_RPC_URLS=https://solana-mainnet.g.alchemy.com/v2/your_key
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_key

# Helius API (for enhanced Solana features)
# Multi-account rotation: create 3-4 free Helius accounts and number the keys.
# Each key becomes its own pool_engine endpoint; 429s cool ONE key and the
# next call rotates to a sibling account. Keys can also live encrypted in the
# DB secure_credentials table under the same names (preferred for prod).
HELIUS_API_KEY=your_helius_api_key
HELIUS_API_KEY_2=
HELIUS_API_KEY_3=
HELIUS_API_KEY_4=

# Etherscan V2 API (EVM leader monitoring in COPY, on-chain lookups)
# Two accounts recommended — same numbered rotation pattern.
ETHERSCAN_API_KEY=your_etherscan_api_key
ETHERSCAN_API_KEY_2=

# Birdeye API (Solana wallet discovery source; free tier is Solana-only)
BIRDEYE_API_KEY=your_birdeye_api_key
BIRDEYE_API_KEY_2=

# Jupiter Aggregator API
JUPITER_API_URL=https://quote-api.jup.ag/v6
JUPITER_API_KEY=your_jupiter_api_key

# Jito Bundle (MEV on Solana)
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# ============================================================================
# NOTIFICATIONS - SENSITIVE DATA ONLY
# ============================================================================
# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook

# Twitter API (for sentiment analysis)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@gmail.com
EMAIL_PASSWORD=your_email_app_password

# ============================================================================
# MONITORING & TOOLS - SENSITIVE DATA ONLY
# ============================================================================
# Sentry Error Tracking
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Grafana
GRAFANA_PASSWORD=your_grafana_admin_password

# pgAdmin (Development)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# Jupyter Notebook
JUPYTER_TOKEN=your_jupyter_token

# ============================================================================
# ARCHITECTURE NOTES
# ============================================================================
#
# Configuration Architecture:
# +-----------------+     +------------------+     +-------------------+
# |   .env file     | --> |  Config Manager  | --> |  Trading Engine   |
# | (sensitive only)|     | (loads from DB)  |     | (uses config)     |
# +-----------------+     +------------------+     +-------------------+
#                                ^
#                                |
#                         +-------------+
#                         | Settings UI |
#                         | (saves to DB)|
#                         +-------------+
#
# What goes where:
# - .env: API keys, private keys, passwords, RPC URLs, encryption keys
# - Database: Trading parameters, risk settings, pairs, strategies, UI preferences
#
# Benefits:
# - Change trading settings without restart
# - Audit trail of all config changes
# - Role-based access to sensitive vs non-sensitive settings
# - Consistent configuration across all modules
#
# ============================================================================

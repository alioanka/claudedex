# kubernetes/secret.yaml.template
#
# Version-controlled placeholder for the cluster Secret `trading-secrets`.
# DO NOT replace placeholders here and commit — `secret.yaml` (no .template
# suffix) is gitignored.
#
# Usage:
#   1. cp kubernetes/secret.yaml.template kubernetes/secret.yaml
#   2. Edit kubernetes/secret.yaml and replace every REPLACE_ME with the
#      real value for your environment.
#   3. Apply AFTER configmap.yaml and BEFORE deployment.yaml:
#        kubectl -n trading apply -f kubernetes/secret.yaml
#
# Production / GitOps: prefer the sealed-secrets variant in
#   kubernetes/secret.sealedsecrets.yaml.template
# Sealed values are asymmetric-encrypted to the cluster's sealed-secrets
# controller pubkey and are safe to commit.
#
# Alternative bootstrap from a local .env file:
#   kubectl -n trading create secret generic trading-secrets \
#     --from-env-file=.env
# Note the key-name mapping: K8s Secret keys here use hyphens
# (`database-url`), but env-file lines use SHOUTING_SNAKE_CASE
# (`DATABASE_URL=...`). When using --from-env-file the K8s key takes the
# env-var name verbatim, so deployment.yaml's `secretKeyRef.key` values
# must match whichever convention you choose. The templates below use
# hyphenated keys to match the existing deployment.yaml stanzas.
#
# The `encryption-key` field is projected into the container as a file at
# /secure/encryption.key (mode 0400) via deployment.yaml's volumeMounts —
# this matches security/secrets_manager.py._external_key_path default.
---
apiVersion: v1
kind: Secret
metadata:
  name: trading-secrets
  namespace: trading
type: Opaque
stringData:
  # --- Infrastructure ---
  database-url: REPLACE_ME
  redis-url: REPLACE_ME
  api-keys: REPLACE_ME
  encryption-key: REPLACE_ME

  # --- DEX (EVM) ---
  private-key: REPLACE_ME
  web3-provider-url: REPLACE_ME
  web3-backup-provider-1: REPLACE_ME
  web3-backup-provider-2: REPLACE_ME
  dexscreener-api-key: REPLACE_ME
  twitter-api-key: REPLACE_ME
  twitter-api-secret: REPLACE_ME

  # --- SOLANA ---
  solana-private-key: REPLACE_ME
  solana-module-private-key: REPLACE_ME
  solana-rpc-url: REPLACE_ME
  helius-api-key: REPLACE_ME
  jupiter-api-key: REPLACE_ME
  jupiter-api-url: REPLACE_ME
  jito-block-engine-url: REPLACE_ME
  jito-tip-account: REPLACE_ME

  # --- ARBITRAGE ---
  flashbots-signing-key: REPLACE_ME
  etherscan-api-key: REPLACE_ME
  wallet-address: REPLACE_ME

  # --- FUTURES ---
  binance-api-key: REPLACE_ME
  binance-api-secret: REPLACE_ME
  bybit-api-key: REPLACE_ME
  bybit-api-secret: REPLACE_ME

  # --- Alerts ---
  telegram-bot-token: REPLACE_ME
  telegram-chat-id: REPLACE_ME
  discord-webhook-url: REPLACE_ME

  # --- Dashboard auth ---
  jwt-secret: REPLACE_ME
  session-secret: REPLACE_ME

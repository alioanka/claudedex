# kubernetes/secret.sealedsecrets.yaml.template
#
# Bitnami sealed-secrets variant of `trading-secrets`. Production / GitOps
# friendly: sealed values are asymmetric-encrypted to the in-cluster
# sealed-secrets controller pubkey, so this file IS safe to commit.
#
# Generate the real manifest from a populated secret.yaml:
#   kubeseal --format=yaml \
#     < kubernetes/secret.yaml \
#     > kubernetes/secret.sealedsecrets.yaml
#
# Reference: https://github.com/bitnami-labs/sealed-secrets
#
# Only one example field is shown below — the real manifest includes a
# sealed entry for every key listed in secret.yaml.template.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: trading-secrets
  namespace: trading
spec:
  template:
    metadata:
      name: trading-secrets
      namespace: trading
    type: Opaque
  encryptedData:
    # Example: the real value here is a long base64 blob produced by
    # kubeseal. Replace with the actual output for each key.
    database-url: AgB1REPLACE_WITH_KUBESEAL_OUTPUT==
